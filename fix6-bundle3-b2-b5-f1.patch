+/* eslint-disable */
+// B2 (right place / right area is chosen and shown to the model) and the editing tools
+// removeObject / clearScene (needed by B5, where a map lives across prompts).
+// Runs the REAL built server as a child process with Nominatim/OSRM stubbed; talks to it with the real MCP SDK client.
+// Usage (repo root, after building shared + server):  node packages/server/test/e2e-places-edit.mjs
+import { spawn } from "node:child_process";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import path from "node:path";
+import { parseScene } from "@map-renderer/shared";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const SERVER_JS = path.resolve(here, "../dist/index.js");
+const STUB = path.resolve(here, "stub-network.mjs");
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const results = [];
+const record = (name, ok, note = "") => {
+  results.push({ name, ok, note });
+  console.log(`${ok ? "PASS" : "FAIL"}  ${name}${note ? "  -- " + note : ""}`);
+};
+async function guard(name, fn) {
+  try { await fn(); } catch (e) { record(`${name} (EXCEPTION)`, false, String(e.stack ?? e).slice(0, 300)); }
+}
+
+async function startServer(port, env = {}) {
+  const child = spawn(process.execPath, ["--import", pathToFileURL(STUB).href, SERVER_JS], {
+    env: { ...process.env, PORT: String(port), NOMINATIM_MIN_INTERVAL_MS: "0", ...env },
+    stdio: ["ignore", "ignore", "pipe"],
+  });
+  let log = "";
+  child.stderr.on("data", (d) => (log += d));
+  for (let i = 0; i < 50; i++) {
+    try { if ((await fetch(`http://127.0.0.1:${port}/health`)).ok) return { child, getLog: () => log, port }; } catch {}
+    await sleep(100);
+  }
+  child.kill();
+  throw new Error("server did not start: " + log);
+}
+const stop = (s) => new Promise((r) => { s.child.once("exit", r); s.child.kill(); });
+
+async function connect(port) {
+  const client = new Client({ name: "places-edit", version: "1.0.0" });
+  await client.connect(new StreamableHTTPClientTransport(new URL(`http://127.0.0.1:${port}/mcp`)));
+  return client;
+}
+const text = (r) => r.content.map((c) => c.text ?? "").join("");
+const call = (c, name, args = {}) => c.callTool({ name, arguments: args }, undefined, { timeout: 10000 });
+const scene = async (c) => JSON.parse(text(await call(c, "renderScene"))).objects;
+const ofType = (objs, t) => objs.filter((o) => o.type === t);
+const countLog = (S, needle) => S.getLog().split("\n").filter((l) => l.includes(needle)).length;
+
+async function main() {
+  const S = await startServer(3971);
+  try {
+    /* ------------------------------ B2: geocoding ------------------------------ */
+    await guard("P", async () => {
+      const c = await connect(S.port);
+      let r = await call(c, "createMarker", { location: "pickme" });
+      let objs = await scene(c);
+      const m = ofType(objs, "marker")[0];
+      record("P1 the most important candidate is used, not the first", !r.isError && m && m.position[0] === 81 && m.position[1] === 21, `pos=${JSON.stringify(m?.position)}`);
+      record("P2 the model is told which place was matched", /Matched "pickme" to "Pickme Major, Bigland"/.test(text(r)), text(r).slice(-120));
+      record("P3 an unambiguous result lists no alternatives (single clear match)", !/Other possible/.test(text(r)));
+
+      r = await call(c, "createMarker", { location: "springfield" });
+      record("P4 an ambiguous name lists real alternatives and asks for a more specific name",
+        /Matched "springfield" to "Springfield, Illinois, USA"/.test(text(r)) && /Other possible matches: "Springfield, Missouri, USA"/.test(text(r)) && /more specific/.test(text(r)), text(r).slice(-200));
+      record("P5 unimportant and invalid candidates are not listed", !/Tiny Hamlet/.test(text(r)) && !/Broken Coordinates/.test(text(r)));
+
+      r = await call(c, "createPath", { start: "pickme", end: "Delhi" });
+      record("P6 a path reports the match of BOTH ends", !r.isError && /Matched "pickme"/.test(text(r)) && /Matched "Delhi"/.test(text(r)), text(r).slice(-160));
+
+      r = await call(c, "createLabel", { location: "pickme", text: "Hello" });
+      record("P7 a label reports the matched place too", !r.isError && /Matched "pickme"/.test(text(r)));
+
+      record("P8 geocoding asks Nominatim for several candidates (limit=5)", /kind=geocode q=pickme thr= limit=5/.test(S.getLog()), "");
+      await c.close();
+    });
+
+    /* ------------------------------ B2: boundaries ----------------------------- */
+    await guard("B", async () => {
+      const c = await connect(S.port);
+      await call(c, "clearScene");
+      let r = await call(c, "createPolygon", { location: "mixedfeatures" });
+      let objs = await scene(c);
+      let poly = ofType(objs, "polygon")[0];
+      record("B1 a Point that ranks first is skipped; the area is highlighted", !r.isError && poly && poly.polygons[0][0][0][0] === 50, `isError=${r.isError} ${text(r).slice(0, 100)}`);
+      record("B2 the model is told which area was matched", /Matched "mixedfeatures" to the area "Mixed Area, Somewhere"/.test(text(r)), text(r).slice(-120));
+
+      await call(c, "clearScene");
+      r = await call(c, "createPolygon", { location: "twoareas" });
+      poly = ofType(await scene(c), "polygon")[0];
+      record("B3 the more important of two areas wins", !r.isError && poly?.polygons[0][0][0][0] === 70 && /Large Area, Region/.test(text(r)), `x=${poly?.polygons[0][0][0][0]}`);
+
+      r = await call(c, "createPolygon", { location: "onlylines" });
+      record("B4 only lines/points -> clear error telling what to do", r.isError === true && /only a point or line, not an area/.test(text(r)) && /createMarker/.test(text(r)), text(r).slice(0, 120));
+
+      record("B5 boundary lookup asks for a few candidates (limit=3)", /kind=boundary q=twoareas thr=0\.001 limit=3/.test(S.getLog()), "");
+      try { parseScene({ version: 1, objects: await scene(c) }); record("B6 resulting scene still passes the shared schema", true); }
+      catch (e) { record("B6 resulting scene still passes the shared schema", false, String(e.message).slice(0, 120)); }
+      await c.close();
+    });
+
+    /* --------------------------- removeObject / clearScene ---------------------- */
+    await guard("E", async () => {
+      const c = await connect(S.port);
+      const tools = (await c.listTools()).tools.map((t) => t.name);
+      record("E0 new tools are listed next to the old ones", ["removeObject", "clearScene", "renderScene", "createMarker"].every((n) => tools.includes(n)), tools.join(","));
+
+      await call(c, "createMarker", { location: "Delhi" });
+      await call(c, "createMarker", { location: "Jaipur" });
+      await call(c, "createPath", { start: "Delhi", end: "Jaipur" });
+      let objs = await scene(c);
+      record("E1a setup: 2 markers + 2 labels + 1 path", objs.length === 5, `n=${objs.length}`);
+
+      let r = await call(c, "removeObject", { name: "  DELHI " });
+      objs = await scene(c);
+      record("E1 removing a place removes its marker AND label (case/space-insensitive)", !r.isError && objs.length === 3 && !objs.some((o) => o.name === "Delhi"), `n=${objs.length} ${text(r)}`);
+      record("E1b the path with a different name is untouched", ofType(objs, "path").length === 1);
+
+      r = await call(c, "createMarker", { location: "Delhi" });
+      objs = await scene(c);
+      record("E1c a removed place can be created again (de-duplication index was cleaned)", /Created marker/.test(text(r)) && objs.length === 5, `n=${objs.length} ${text(r).slice(0, 80)}`);
+
+      r = await call(c, "removeObject", { name: "Atlantis" });
+      record("E2 unknown name -> error that lists the names on the map (so the model can fix itself)", r.isError === true && /Names on the map/.test(text(r)) && /Jaipur/.test(text(r)), text(r).slice(0, 160));
+
+      r = await call(c, "removeObject", { name: "Jaipur", type: "label" });
+      objs = await scene(c);
+      record("E3 type filter removes only that type", !r.isError && ofType(objs, "marker").some((o) => o.name === "Jaipur") && !ofType(objs, "label").some((o) => o.name === "Jaipur"), `labels=${ofType(objs, "label").map((o) => o.name)}`);
+      r = await call(c, "createMarker", { location: "Jaipur" });
+      objs = await scene(c);
+      record("E3b the removed label comes back, the marker is not duplicated", /already exists/.test(text(r)) && /Added label/.test(text(r)) && ofType(objs, "marker").filter((o) => o.name === "Jaipur").length === 1, text(r).slice(0, 120));
+
+      const before = countLog(S, "[stub] osrm");
+      r = await call(c, "removeObject", { name: "delhi → jaipur" });
+      record("E4 a path is removed by its 'A → B' name", !r.isError && ofType(await scene(c), "path").length === 0, text(r).slice(0, 100));
+      r = await call(c, "createPath", { start: "Delhi", end: "Jaipur" });
+      record("E4b the path can be drawn again (new routing request, not a stale duplicate)", /Created path/.test(text(r)) && countLog(S, "[stub] osrm") === before + 1, text(r).slice(0, 80));
+
+      r = await call(c, "removeObject", { name: "x", type: "bogus" }).catch((e) => ({ isError: true, content: [{ text: String(e.message) }] }));
+      record("E5 an invalid type is rejected", r.isError === true, text(r).slice(0, 80));
+
+      r = await call(c, "clearScene");
+      record("E6 clearScene empties the map", !r.isError && (await scene(c)).length === 0 && /Cleared the map \(\d+ object/.test(text(r)), text(r));
+      r = await call(c, "clearScene");
+      record("E6b clearing an empty map is harmless", !r.isError && /already empty/.test(text(r)), text(r));
+      r = await call(c, "createMarker", { location: "Delhi" });
+      record("E6c the map can be rebuilt after clearing", /Created marker/.test(text(r)) && (await scene(c)).length === 2, text(r).slice(0, 80));
+      await c.close();
+    });
+
+    await guard("I", async () => {
+      const a = await connect(S.port);
+      const b = await connect(S.port);
+      await call(a, "createMarker", { location: "Delhi" });
+      await call(b, "createMarker", { location: "Mumbai" });
+      await call(b, "clearScene");
+      const sa = await scene(a);
+      record("E7 clearScene / removeObject only affect their own session's map", sa.length === 2 && (await scene(b)).length === 0, `a=${sa.length}`);
+      await call(b, "createMarker", { location: "Mumbai" });
+      await call(a, "removeObject", { name: "Mumbai" }).catch(() => undefined);
+      record("E7b removing in A does not touch B's objects", (await scene(b)).length === 2);
+      await a.close(); await b.close();
+    });
+  } finally { await stop(S); }
+
+  const failed = results.filter((r) => !r.ok);
+  console.log(`\n${results.length - failed.length}/${results.length} passed`);
+  process.exit(failed.length ? 1 : 0);
+}
+main().catch((e) => { console.error("HARNESS ERROR", e); process.exit(2); });
diff --git a/packages/server/test/e2e-security.mjs b/packages/server/test/e2e-security.mjs
new file mode 100644
index 0000000..f72f554
--- /dev/null
+++ b/packages/server/test/e2e-security.mjs
@@ -0,0 +1,158 @@
+/* eslint-disable */
+// D1 for the MCP server: where it listens, which browser origins are refused, optional bearer token,
+// request body size limit. Real built server as a child process.
+// Usage (repo root, after building shared + server):  node packages/server/test/e2e-security.mjs
+import { spawn } from "node:child_process";
+import http from "node:http";
+import os from "node:os";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import path from "node:path";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const SERVER_JS = path.resolve(here, "../dist/index.js");
+const STUB = path.resolve(here, "stub-network.mjs");
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const results = [];
+const record = (name, ok, note = "") => {
+  results.push({ name, ok, note });
+  console.log(`${ok ? "PASS" : "FAIL"}  ${name}${note ? "  -- " + note : ""}`);
+};
+async function guard(name, fn) {
+  try { await fn(); } catch (e) { record(`${name} (EXCEPTION)`, false, String(e.stack ?? e).slice(0, 300)); }
+}
+
+async function startServer(port, env = {}) {
+  const child = spawn(process.execPath, ["--import", pathToFileURL(STUB).href, SERVER_JS], {
+    env: { ...process.env, PORT: String(port), NOMINATIM_MIN_INTERVAL_MS: "0", ...env },
+    stdio: ["ignore", "ignore", "pipe"],
+  });
+  let log = "";
+  child.stderr.on("data", (d) => (log += d));
+  for (let i = 0; i < 50; i++) {
+    try { if ((await fetch(`http://127.0.0.1:${port}/health`)).ok) return { child, getLog: () => log, port }; } catch {}
+    await sleep(100);
+  }
+  child.kill();
+  throw new Error("server did not start: " + log);
+}
+const stop = (s) => new Promise((r) => { s.child.once("exit", r); s.child.kill(); });
+
+const INIT = {
+  jsonrpc: "2.0", id: 1, method: "initialize",
+  params: { protocolVersion: "2025-03-26", capabilities: {}, clientInfo: { name: "sec", version: "1" } },
+};
+const post = (port, body, headers = {}) => fetch(`http://127.0.0.1:${port}/mcp`, {
+  method: "POST",
+  headers: { "content-type": "application/json", accept: "application/json, text/event-stream", ...headers },
+  body: typeof body === "string" ? body : JSON.stringify(body),
+});
+
+/** First non-loopback IPv4 address of this machine, if any. */
+const externalIp = () => {
+  for (const list of Object.values(os.networkInterfaces()))
+    for (const i of list ?? []) if (i.family === "IPv4" && !i.internal) return i.address;
+  return null;
+};
+const canConnect = (host, port) => new Promise((resolve) => {
+  const req = http.get({ host, port, path: "/health", timeout: 1500 }, (res) => { res.resume(); resolve(true); });
+  req.on("error", () => resolve(false));
+  req.on("timeout", () => { req.destroy(); resolve(false); });
+});
+
+async function main() {
+  const ext = externalIp();
+
+  /* ----------------------------- listening address ---------------------------- */
+  const D = await startServer(3981);
+  const W = await startServer(3982, { HOST: "0.0.0.0" });
+  try {
+    await guard("H", async () => {
+      record("H1 default: reachable on 127.0.0.1", await canConnect("127.0.0.1", D.port));
+      if (ext) {
+        record("H2 default: NOT reachable through the machine's network address (not exposed)", !(await canConnect(ext, D.port)), `ext=${ext}`);
+        record("H3 HOST=0.0.0.0 still works when the owner asks for it (proves H2 is real)", await canConnect(ext, W.port), `ext=${ext}`);
+      } else {
+        console.log("SKIP  H2/H3 no non-loopback network interface in this environment (check by hand)");
+      }
+    });
+
+    /* ------------------------------ origin + body ------------------------------- */
+    await guard("O", async () => {
+      let r = await post(D.port, INIT);
+      record("O1 a client without Origin (like ai-server) works", r.status === 200, `status=${r.status}`);
+      r = await post(D.port, INIT, { origin: "http://evil.example" });
+      const body = await r.json().catch(() => ({}));
+      record("O2 a browser Origin that is not listed is refused with 403", r.status === 403 && /ALLOWED_ORIGINS/.test(body.error ?? ""), `status=${r.status} ${JSON.stringify(body)}`);
+      r = await fetch(`http://127.0.0.1:${D.port}/health`, { headers: { origin: "http://evil.example" } });
+      record("O3 /health stays open (monitoring)", r.status === 200);
+
+      const big = JSON.stringify({ ...INIT, padding: "x".repeat(2 * 1024 * 1024) });
+      r = await post(D.port, big);
+      record("O4 a body over the default limit (1 MB) -> 413", r.status === 413, `status=${r.status}`);
+      r = await post(D.port, INIT);
+      record("O5 the server is still healthy after rejecting an oversized body", r.status === 200);
+    });
+  } finally { await stop(D); await stop(W); }
+
+  const A = await startServer(3983, { ALLOWED_ORIGINS: "http://ok.example", MAX_BODY_BYTES: "1500" });
+  try {
+    await guard("A", async () => {
+      let r = await post(A.port, INIT, { origin: "http://ok.example" });
+      record("A1 a listed Origin is accepted", r.status === 200, `status=${r.status}`);
+      r = await post(A.port, INIT, { origin: "http://ok.example.evil.test" });
+      record("A2 a look-alike origin is refused (exact match only)", r.status === 403);
+      r = await post(A.port, JSON.stringify({ ...INIT, padding: "x".repeat(3000) }));
+      record("A3 MAX_BODY_BYTES is honoured (3 KB body vs 1.5 KB limit) -> 413", r.status === 413, `status=${r.status}`);
+
+      // Body without Content-Length (chunked) that grows past the limit.
+      const status = await new Promise((resolve) => {
+        const req = http.request({ host: "127.0.0.1", port: A.port, path: "/mcp", method: "POST",
+          headers: { "content-type": "application/json", accept: "application/json, text/event-stream", "transfer-encoding": "chunked" } },
+          (res) => { res.resume(); resolve(res.statusCode); });
+        req.on("error", () => resolve("closed"));
+        req.write("{\"a\":\"" + "y".repeat(1000));
+        setTimeout(() => { req.write("y".repeat(2000)); req.end("\"}"); }, 50);
+        setTimeout(() => resolve("timeout"), 4000);
+      });
+      record("A4 a chunked body with no Content-Length is cut off too (413 or connection closed)", status === 413 || status === "closed", `result=${status}`);
+      r = await post(A.port, INIT);
+      record("A5 still serving afterwards", r.status === 200);
+    });
+  } finally { await stop(A); }
+
+  /* --------------------------------- token ----------------------------------- */
+  const T = await startServer(3984, { MCP_AUTH_TOKEN: "s3cret-token" });
+  try {
+    await guard("T", async () => {
+      let r = await post(T.port, INIT);
+      record("T1 token set: no Authorization -> 401", r.status === 401, `status=${r.status}`);
+      r = await post(T.port, INIT, { authorization: "Bearer wrong" });
+      record("T2 token set: wrong token -> 401", r.status === 401);
+      r = await post(T.port, INIT, { authorization: "Bearer s3cret-token" });
+      record("T3 token set: right token -> 200", r.status === 200);
+      r = await fetch(`http://127.0.0.1:${T.port}/health`);
+      record("T4 /health needs no token", r.status === 200);
+
+      const withToken = new Client({ name: "tok", version: "1" });
+      await withToken.connect(new StreamableHTTPClientTransport(new URL(`http://127.0.0.1:${T.port}/mcp`), {
+        requestInit: { headers: { Authorization: "Bearer s3cret-token" } },
+      }));
+      const tools = (await withToken.listTools()).tools.length;
+      const res = await withToken.callTool({ name: "clearScene", arguments: {} });
+      record("T5 a real MCP client with the token can list and call tools for a whole session", tools >= 5 && !res.isError, `tools=${tools}`);
+      await withToken.close();
+
+      const without = new Client({ name: "notok", version: "1" });
+      const failed = await without.connect(new StreamableHTTPClientTransport(new URL(`http://127.0.0.1:${T.port}/mcp`))).then(() => false, () => true);
+      record("T6 a real MCP client without the token cannot connect", failed);
+      await without.close().catch(() => undefined);
+    });
+  } finally { await stop(T); }
+
+  const failed = results.filter((r) => !r.ok);
+  console.log(`\n${results.length - failed.length}/${results.length} passed`);
+  process.exit(failed.length ? 1 : 0);
+}
+main().catch((e) => { console.error("HARNESS ERROR", e); process.exit(2); });
diff --git a/packages/server/test/places.test.mjs b/packages/server/test/places.test.mjs
new file mode 100644
index 0000000..1a63594
--- /dev/null
+++ b/packages/server/test/places.test.mjs
@@ -0,0 +1,188 @@
+// Unit tests for B2 (picking the right geocoding / boundary candidate) and the HTTP guard (D1).
+// Uses built output: run after building shared + server.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { PassThrough } from "node:stream";
+import { pickPlace, describePlace } from "../dist/services/GeocodingService.js";
+import { pickBoundary } from "../dist/services/BoundaryService.js";
+import {
+  BodyTooLargeError, checkRequest, parseList, readBodyLimited, readGuardConfig, tokenMatches,
+} from "../dist/httpGuard.js";
+
+const place = (lat, lon, name, importance) => ({ lat: String(lat), lon: String(lon), display_name: name, importance });
+const square = (x, y, d) => [[x, y], [x + d, y], [x + d, y + d], [x, y + d], [x, y]];
+const area = (name, importance, ring = square(0, 0, 1)) => ({
+  properties: { display_name: name, importance }, geometry: { type: "Polygon", coordinates: [ring] },
+});
+
+/* ------------------------------- pickPlace ------------------------------- */
+
+test("pickPlace: the most important candidate wins, not the first", () => {
+  const r = pickPlace([place(1, 2, "Minor", 0.2), place(3, 4, "Major", 0.9)], "x");
+  assert.equal(r.name, "Major");
+  assert.deepEqual(r.point, [4, 3]); // [lng, lat]
+});
+
+test("pickPlace: equal importance keeps Nominatim's order", () => {
+  const r = pickPlace([place(1, 2, "First", 0.5), place(3, 4, "Second", 0.5)], "x");
+  assert.equal(r.name, "First");
+});
+
+test("pickPlace: lists similarly important, differently named runners-up (max 2)", () => {
+  const r = pickPlace([
+    place(1, 1, "A", 0.8), place(2, 2, "B", 0.7), place(3, 3, "C", 0.6), place(4, 4, "D", 0.59),
+  ], "x");
+  assert.deepEqual(r.alternatives, ["B", "C"]);
+});
+
+test("pickPlace: unimportant runners-up and same-name duplicates are not alternatives", () => {
+  const r = pickPlace([place(1, 1, "A", 0.8), place(2, 2, "Z", 0.1), place(3, 3, "A", 0.79)], "x");
+  assert.deepEqual(r.alternatives, []);
+});
+
+test("pickPlace: invalid / out-of-range / non-object candidates are skipped", () => {
+  const r = pickPlace([null, "x", { lat: "abc", lon: "1" }, place(95, 10, "BadLat", 0.99), place(10, 200, "BadLon", 0.99), place(5, 6, "Good", 0.1)], "q");
+  assert.equal(r.name, "Good");
+});
+
+test("pickPlace: nothing usable -> null; non-array -> null", () => {
+  assert.equal(pickPlace([{ lat: "x", lon: "y" }], "q"), null);
+  assert.equal(pickPlace({}, "q"), null);
+  assert.equal(pickPlace([], "q"), null);
+});
+
+test("pickPlace: results without display_name/importance (old shape) still work, name falls back to the query", () => {
+  const r = pickPlace([{ lat: "8", lon: "70" }], "Delhi");
+  assert.equal(r.name, "Delhi");
+  assert.deepEqual(r.point, [70, 8]);
+});
+
+test("pickPlace: very long names are shortened", () => {
+  const r = pickPlace([place(1, 1, "N".repeat(500), 0.5)], "q");
+  assert.ok(r.name.length <= 120);
+});
+
+test("describePlace: says what was matched; mentions alternatives only when there are some", () => {
+  const plain = describePlace("Paris", { point: [0, 0], name: "Paris, France", alternatives: [] });
+  assert.match(plain, /Matched "Paris" to "Paris, France"\./);
+  assert.doesNotMatch(plain, /Other possible/);
+  const amb = describePlace("Paris", { point: [0, 0], name: "Paris, France", alternatives: ["Paris, Texas, USA"] });
+  assert.match(amb, /Other possible matches: "Paris, Texas, USA"/);
+  assert.match(amb, /more specific name/);
+});
+
+/* ------------------------------ pickBoundary ----------------------------- */
+
+test("pickBoundary: a Point is skipped even when it ranks first", () => {
+  const r = pickBoundary([{ properties: { importance: 0.99 }, geometry: { type: "Point", coordinates: [1, 1] } }, area("The Area", 0.1)], "q");
+  assert.equal(r.name, "The Area");
+  assert.equal(r.polygons.length, 1);
+});
+
+test("pickBoundary: the more important area wins", () => {
+  const r = pickBoundary([area("Small", 0.3), area("Large", 0.8)], "q");
+  assert.equal(r.name, "Large");
+});
+
+test("pickBoundary: an area with only unusable rings is skipped for the next one", () => {
+  const junk = { properties: { display_name: "Junk", importance: 0.9 }, geometry: { type: "Polygon", coordinates: [[[1, 1], [2, 2]]] } };
+  const r = pickBoundary([junk, area("Fine", 0.2)], "q");
+  assert.equal(r.name, "Fine");
+});
+
+test("pickBoundary: only points/lines, empty, or garbage -> null", () => {
+  assert.equal(pickBoundary([{ geometry: { type: "LineString", coordinates: [] } }], "q"), null);
+  assert.equal(pickBoundary([], "q"), null);
+  assert.equal(pickBoundary("nope", "q"), null);
+  assert.equal(pickBoundary([null, 5, { geometry: null }], "q"), null);
+});
+
+test("pickBoundary: name falls back to the query when display_name is missing", () => {
+  const r = pickBoundary([{ geometry: { type: "Polygon", coordinates: [square(0, 0, 1)] } }], "Rajasthan");
+  assert.equal(r.name, "Rajasthan");
+});
+
+/* ------------------------------- http guard ------------------------------ */
+
+test("readGuardConfig: safe defaults", () => {
+  const c = readGuardConfig({});
+  assert.equal(c.host, "127.0.0.1");
+  assert.deepEqual(c.allowedOrigins, []);
+  assert.equal(c.authToken, undefined);
+  assert.equal(c.maxBodyBytes, 1024 * 1024);
+});
+
+test("readGuardConfig: env overrides; junk numbers fall back", () => {
+  const c = readGuardConfig({ HOST: "0.0.0.0", ALLOWED_ORIGINS: " http://a.test , http://b.test ,", MCP_AUTH_TOKEN: " tok ", MAX_BODY_BYTES: "5000" });
+  assert.equal(c.host, "0.0.0.0");
+  assert.deepEqual(c.allowedOrigins, ["http://a.test", "http://b.test"]);
+  assert.equal(c.authToken, "tok");
+  assert.equal(c.maxBodyBytes, 5000);
+  assert.equal(readGuardConfig({ MAX_BODY_BYTES: "-3" }).maxBodyBytes, 1024 * 1024);
+  assert.equal(readGuardConfig({ MAX_BODY_BYTES: "abc" }).maxBodyBytes, 1024 * 1024);
+  assert.equal(readGuardConfig({ MCP_AUTH_TOKEN: "   " }).authToken, undefined);
+  assert.deepEqual(parseList(undefined), []);
+});
+
+test("tokenMatches: only the exact bearer token", () => {
+  assert.equal(tokenMatches("Bearer secret", "secret"), true);
+  assert.equal(tokenMatches("bearer secret", "secret"), true);
+  assert.equal(tokenMatches("Bearer wrong", "secret"), false);
+  assert.equal(tokenMatches("secret", "secret"), false);
+  assert.equal(tokenMatches(undefined, "secret"), false);
+  assert.equal(tokenMatches("Bearer ", "secret"), false);
+  assert.equal(tokenMatches("Bearer secret2", "secret"), false);
+});
+
+const fakeReq = (headers = {}) => ({ headers });
+
+test("checkRequest: no Origin header (normal MCP clients) is fine by default", () => {
+  assert.equal(checkRequest(fakeReq(), readGuardConfig({})), null);
+});
+
+test("checkRequest: a browser Origin is refused unless listed (DNS-rebinding / cross-site protection)", () => {
+  const cfg = readGuardConfig({ ALLOWED_ORIGINS: "http://ok.test" });
+  assert.equal(checkRequest(fakeReq({ origin: "http://evil.test" }), cfg).status, 403);
+  assert.equal(checkRequest(fakeReq({ origin: "http://ok.test" }), cfg), null);
+  assert.equal(checkRequest(fakeReq({ origin: "http://evil.test" }), readGuardConfig({})).status, 403);
+  assert.equal(checkRequest(fakeReq({ origin: "http://anything.test" }), readGuardConfig({ ALLOWED_ORIGINS: "*" })), null);
+});
+
+test("checkRequest: with a token configured, missing/wrong -> 401, right -> ok", () => {
+  const cfg = readGuardConfig({ MCP_AUTH_TOKEN: "s3cret" });
+  assert.equal(checkRequest(fakeReq(), cfg).status, 401);
+  assert.equal(checkRequest(fakeReq({ authorization: "Bearer nope" }), cfg).status, 401);
+  assert.equal(checkRequest(fakeReq({ authorization: "Bearer s3cret" }), cfg), null);
+});
+
+function bodyStream(headers = {}) {
+  const s = new PassThrough();
+  s.headers = headers;
+  return s;
+}
+
+test("readBodyLimited: reads a body under the limit", async () => {
+  const s = bodyStream();
+  const p = readBodyLimited(s, 100);
+  s.write("hello "); s.end("world");
+  assert.equal((await p).toString(), "hello world");
+});
+
+test("readBodyLimited: rejects as soon as the declared Content-Length is too big", async () => {
+  const s = bodyStream({ "content-length": "5000" });
+  await assert.rejects(readBodyLimited(s, 100), BodyTooLargeError);
+});
+
+test("readBodyLimited: rejects a body that grows past the limit without a Content-Length", async () => {
+  const s = bodyStream();
+  const p = readBodyLimited(s, 10);
+  s.write("12345"); s.write("67890"); s.write("X");
+  await assert.rejects(p, BodyTooLargeError);
+});
+
+test("readBodyLimited: exactly the limit is accepted", async () => {
+  const s = bodyStream();
+  const p = readBodyLimited(s, 5);
+  s.end("12345");
+  assert.equal((await p).length, 5);
+});
