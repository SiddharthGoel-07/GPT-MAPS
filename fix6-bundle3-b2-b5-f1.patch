+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { runChat } from "../src/chatLoop.ts";
+import type { Llm, LlmReply, McpLike, ToolCall } from "../src/chatLoop.ts";
+
+const limits = { maxPromptChars: 100, maxToolIterations: 5, requestTimeoutMs: 1000 };
+let id = 0;
+const call = (name: string, args: unknown = {}): ToolCall => ({ id: `c${++id}`, name, arguments: JSON.stringify(args) });
+const reply = (content: string | null, ...toolCalls: ToolCall[]): LlmReply => ({ content, toolCalls });
+
+function run(replies: LlmReply[], extra: Record<string, unknown> = {}) {
+  const sent: Array<Array<Record<string, unknown>>> = [];
+  let turn = 0;
+  const llm: Llm = { async complete(messages) { sent.push(structuredClone(messages)); return replies[turn++]!; } };
+  const mcp: McpLike = {
+    async listTools() { return []; },
+    async callTool(name) { return { text: name === "renderScene" ? JSON.stringify({ version: 1, objects: [] }) : "ok", isError: false }; },
+  };
+  const controller = new AbortController();
+  const promise = runChat({
+    prompt: "add Mumbai", systemPrompt: "SYS", llm, mcp, limits,
+    context: { signal: controller.signal, deadlineAt: Date.now() + 1000 }, ...extra,
+  });
+  return { promise, sent };
+}
+
+test("messages: system, earlier turns, then the new prompt (unchanged when the map is empty)", async () => {
+  const { promise, sent } = run([reply("ok")], {
+    history: [{ role: "user", content: "show Delhi" }, { role: "assistant", content: "Done." }],
+  });
+  await promise;
+  const roles = sent[0]!.map((m) => m.role);
+  assert.deepEqual(roles, ["system", "user", "assistant", "user"]);
+  assert.equal(sent[0]![0]!.content, "SYS");
+  assert.equal(sent[0]![1]!.content, "show Delhi");
+  assert.equal(sent[0]![3]!.content, "add Mumbai", "no map context for an empty map");
+});
+
+test("a non-empty map is described in front of the new request", async () => {
+  const { promise, sent } = run([reply("ok")], { mapSummary: 'Markers: "Delhi"' });
+  await promise;
+  const last = sent[0]!.at(-1)!;
+  assert.match(String(last.content), /Markers: "Delhi"/);
+  assert.match(String(last.content), /User request: add Mumbai/);
+});
+
+test("without history/mapSummary the messages are exactly the old two (system + prompt)", async () => {
+  const { promise, sent } = run([reply("ok")]);
+  await promise;
+  assert.deepEqual(sent[0], [{ role: "system", content: "SYS" }, { role: "user", content: "add Mumbai" }]);
+});
+
+test("the prompt length limit is checked on the user's text, not on the map context", async () => {
+  const { promise } = run([reply("ok")], { mapSummary: "M".repeat(5000), prompt: "x".repeat(100) });
+  await promise; // would throw 400 if the context counted
+});
+
+test("progress: understanding, then each tool in order, then drawing", async () => {
+  const events: string[] = [];
+  const { promise } = run(
+    [reply(null, call("createMarker", { location: "Delhi" }), call("createPath", { start: "Delhi", end: "Jaipur" }), call("renderScene")), reply("never")],
+    { onProgress: (t: string) => events.push(t) }
+  );
+  await promise;
+  assert.deepEqual(events, ["Understanding your request…", "Finding Delhi…", "Finding a route from Delhi to Jaipur…", "Drawing the map…"]);
+});
+
+test("progress: a second LLM turn says 'Planning the next step'", async () => {
+  const events: string[] = [];
+  const { promise } = run([reply(null, call("createMarker", { location: "Delhi" })), reply("done")], { onProgress: (t: string) => events.push(t) });
+  await promise;
+  assert.ok(events.includes("Planning the next step…"));
+});
+
+test("progress: a callback that throws never breaks the chat", async () => {
+  const { promise } = run([reply("fine")], { onProgress: () => { throw new Error("socket closed"); } });
+  const r = await promise;
+  assert.equal(r.message, "fine");
+});
+
+test("progress: bad tool arguments produce no progress line and no crash", async () => {
+  const events: string[] = [];
+  const bad: ToolCall = { id: "bad1", name: "createMarker", arguments: "{not json" };
+  const { promise } = run([reply(null, bad), reply("ok")], { onProgress: (t: string) => events.push(t) });
+  await promise;
+  assert.ok(!events.some((e) => e.startsWith("Finding")));
+});
diff --git a/packages/ai-server/test/conversations.test.ts b/packages/ai-server/test/conversations.test.ts
new file mode 100644
index 0000000..5fbfcde
--- /dev/null
+++ b/packages/ai-server/test/conversations.test.ts
@@ -0,0 +1,219 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ConversationStore } from "../src/conversations.ts";
+import type { McpConnectionLike } from "../src/conversations.ts";
+import type { McpLike } from "../src/chatLoop.ts";
+import { ChatError } from "../src/errors.ts";
+
+const signal = new AbortController().signal;
+
+interface FakeConn extends McpConnectionLike { closed: boolean; pings: number; failPing: boolean; id: number }
+
+function setup(over: { ttlMs?: number; maxConversations?: number } = {}) {
+  let now = 1_000_000;
+  const conns: FakeConn[] = [];
+  let failConnect = false;
+  const store = new ConversationStore({
+    now: () => now,
+    connect: async () => {
+      if (failConnect) throw new Error("mcp down");
+      const conn: FakeConn = {
+        id: conns.length, closed: false, pings: 0, failPing: false,
+        mcp: {
+          async listTools() { conn.pings++; if (conn.failPing) throw new Error("session not found"); return []; },
+          async callTool() { return { text: "{}", isError: false }; },
+        } as McpLike,
+        async close() { conn.closed = true; },
+      };
+      conns.push(conn);
+      return conn;
+    },
+    ttlMs: over.ttlMs ?? 1000,
+    maxConversations: over.maxConversations ?? 3,
+  });
+  return { store, conns, advance: (ms: number) => (now += ms), setFailConnect: (v: boolean) => (failConnect = v) };
+}
+
+const ID = (n: number) => `conversation-${n}`;
+
+test("a new id opens a conversation; the same id later CONTINUES it (one connection, history kept)", async () => {
+  const { store, conns } = setup();
+  const a = await store.acquire(ID(1), signal);
+  assert.equal(a.resumed, false);
+  assert.deepEqual(a.history, []);
+  a.commit("show Delhi", "Done.");
+  await a.release();
+
+  const b = await store.acquire(ID(1), signal);
+  assert.equal(b.resumed, true);
+  assert.deepEqual(b.history, [{ role: "user", content: "show Delhi" }, { role: "assistant", content: "Done." }]);
+  assert.equal(conns.length, 1, "no second MCP connection");
+  assert.equal(conns[0]!.pings, 1, "continuing proves the session is alive with one round trip");
+  assert.equal(conns[0]!.closed, false);
+  await b.release();
+});
+
+test("different ids are different maps", async () => {
+  const { store, conns } = setup();
+  const a = await store.acquire(ID(1), signal);
+  const b = await store.acquire(ID(2), signal);
+  assert.notEqual(a.mcp, b.mcp);
+  assert.equal(conns.length, 2);
+  assert.equal(store.size, 2);
+});
+
+test("an invalid id is a 400", async () => {
+  const { store } = setup();
+  for (const bad of ["short", "has space here", "x".repeat(65), "../../etc/passwd", "ünïcode-id-1234"]) {
+    await assert.rejects(store.acquire(bad, signal), (e) => e instanceof ChatError && e.status === 400, bad);
+  }
+});
+
+test("one request at a time per conversation: a parallel one gets 409, and works after release", async () => {
+  const { store } = setup();
+  const a = await store.acquire(ID(1), signal);
+  await assert.rejects(store.acquire(ID(1), signal), (e) => e instanceof ChatError && e.status === 409);
+  await a.release();
+  const b = await store.acquire(ID(1), signal);
+  assert.equal(b.resumed, true);
+});
+
+test("two parallel requests for the SAME NEW id: exactly one wins (409 for the other), one connection", async () => {
+  const { store, conns } = setup();
+  const results = await Promise.allSettled([store.acquire(ID(7), signal), store.acquire(ID(7), signal)]);
+  assert.equal(results.filter((r) => r.status === "fulfilled").length, 1);
+  const rejected = results.find((r) => r.status === "rejected") as PromiseRejectedResult;
+  assert.equal((rejected.reason as ChatError).status, 409);
+  assert.equal(conns.length, 1);
+});
+
+test("a lost MCP session is replaced by a fresh one: not resumed, history cleared, old connection closed", async () => {
+  const { store, conns } = setup();
+  const a = await store.acquire(ID(1), signal);
+  a.commit("show Delhi", "Done.");
+  await a.release();
+  conns[0]!.failPing = true; // server forgot the session (TTL / restart)
+
+  const b = await store.acquire(ID(1), signal);
+  assert.equal(b.resumed, false);
+  assert.deepEqual(b.history, []);
+  assert.equal(conns.length, 2);
+  assert.equal(conns[0]!.closed, true);
+  assert.notEqual(b.mcp, a.mcp);
+  await b.release();
+  const c = await store.acquire(ID(1), signal);
+  assert.equal(c.resumed, true, "the replacement is a normal conversation again");
+});
+
+test("an abort during the liveness check is rethrown (no silent new map) and does not leave the conversation stuck busy", async () => {
+  const { store, conns } = setup();
+  const a = await store.acquire(ID(1), signal);
+  await a.release();
+  conns[0]!.failPing = true;
+  const controller = new AbortController();
+  controller.abort(new Error("deadline"));
+  await assert.rejects(store.acquire(ID(1), controller.signal), /session not found/);
+  assert.equal(conns.length, 1, "no reconnect attempted");
+  conns[0]!.failPing = false;
+  const again = await store.acquire(ID(1), signal);
+  assert.equal(again.resumed, true);
+});
+
+test("a failing connect leaves nothing behind and can be retried", async () => {
+  const { store, setFailConnect } = setup();
+  setFailConnect(true);
+  await assert.rejects(store.acquire(ID(1), signal), /mcp down/);
+  assert.equal(store.size, 0);
+  setFailConnect(false);
+  const a = await store.acquire(ID(1), signal);
+  assert.equal(a.resumed, false);
+});
+
+test("one-shot (no id): own connection, closed on release, never stored", async () => {
+  const { store, conns } = setup();
+  const lease = await store.acquire(undefined, signal);
+  assert.equal(lease.id, undefined);
+  assert.equal(store.size, 0);
+  lease.commit("x", "y"); // no-op, must not throw
+  await lease.release();
+  assert.equal(conns[0]!.closed, true);
+});
+
+test("idle conversations are closed after the TTL; busy ones never are", async () => {
+  const { store, conns, advance } = setup({ ttlMs: 1000 });
+  const idle = await store.acquire(ID(1), signal); await idle.release();
+  const busy = await store.acquire(ID(2), signal);
+  advance(1500);
+  await store.sweep();
+  assert.equal(conns[0]!.closed, true);
+  assert.equal(conns[1]!.closed, false);
+  assert.equal(store.size, 1);
+  await busy.release();
+  advance(500); await store.sweep();
+  assert.equal(conns[1]!.closed, false, "TTL counts from the end of the last request");
+  advance(600); await store.sweep();
+  assert.equal(conns[1]!.closed, true);
+});
+
+test("at the cap the least recently used IDLE conversation is evicted", async () => {
+  const { store, conns, advance } = setup({ maxConversations: 2 });
+  const a = await store.acquire(ID(1), signal); await a.release(); advance(10);
+  const b = await store.acquire(ID(2), signal); await b.release(); advance(10);
+  const c = await store.acquire(ID(3), signal);
+  assert.equal(conns[0]!.closed, true, "oldest idle (1) evicted");
+  assert.equal(conns[1]!.closed, false);
+  assert.equal(store.size, 2);
+  await c.release();
+});
+
+test("at the cap with everything busy -> 503, and the failed attempt leaves no ghost entry", async () => {
+  const { store } = setup({ maxConversations: 2 });
+  await store.acquire(ID(1), signal); await store.acquire(ID(2), signal);
+  await assert.rejects(store.acquire(ID(3), signal), (e) => e instanceof ChatError && e.status === 503);
+  assert.equal(store.size, 2);
+});
+
+test("remove(): closes the conversation; unknown id -> false; busy -> 409", async () => {
+  const { store, conns } = setup();
+  const a = await store.acquire(ID(1), signal);
+  await assert.rejects(store.remove(ID(1)), (e) => e instanceof ChatError && e.status === 409);
+  await a.release();
+  assert.equal(await store.remove(ID(1)), true);
+  assert.equal(conns[0]!.closed, true);
+  assert.equal(await store.remove(ID(1)), false);
+  const again = await store.acquire(ID(1), signal);
+  assert.equal(again.resumed, false, "after remove the id starts a fresh map");
+});
+
+test("history keeps only the last 6 turns and clips long texts", async () => {
+  const { store } = setup();
+  const a = await store.acquire(ID(1), signal);
+  for (let i = 0; i < 10; i++) a.commit(`prompt ${i}`, `answer ${i}`);
+  a.commit("p".repeat(5000), "a".repeat(5000));
+  await a.release();
+  const b = await store.acquire(ID(1), signal);
+  assert.equal(b.history.length, 12);
+  assert.equal(b.history[0]!.content, "prompt 5");
+  assert.ok(b.history.at(-1)!.content.length <= 600);
+  assert.ok(b.history.at(-2)!.content.length <= 600);
+});
+
+test("a lease's history is a snapshot: changing it cannot corrupt the store", async () => {
+  const { store } = setup();
+  const a = await store.acquire(ID(1), signal);
+  a.commit("one", "two"); await a.release();
+  const b = await store.acquire(ID(1), signal);
+  (b.history as unknown as unknown[]).push({ role: "user", content: "tampered" });
+  await b.release();
+  const c = await store.acquire(ID(1), signal);
+  assert.equal(c.history.length, 2);
+});
+
+test("closeAll closes every connection", async () => {
+  const { store, conns } = setup();
+  await (await store.acquire(ID(1), signal)).release();
+  await (await store.acquire(ID(2), signal)).release();
+  await store.closeAll();
+  assert.ok(conns.every((c) => c.closed));
+  assert.equal(store.size, 0);
+});
diff --git a/packages/ai-server/test/e2e-conversations.mjs b/packages/ai-server/test/e2e-conversations.mjs
new file mode 100644
index 0000000..2dcffd3
--- /dev/null
+++ b/packages/ai-server/test/e2e-conversations.mjs
@@ -0,0 +1,224 @@
+/* eslint-disable */
+// B5 (a map that lives across prompts) and F1 (progress stream, accurate errors), black-box.
+//   fake Groq  <--  REAL ai-server (dist)  -->  REAL MCP server (dist, network stubbed)
+// Usage (repo root, after building shared, server, ai-server):  node packages/ai-server/test/e2e-conversations.mjs
+// Ports: MCP 4001 / 4002 (short session TTL) / 4003 (never started); ai-server 4011+; fake Groq 4021+.
+import { AI_JS, byType, chat, chatStream, completion, createReporter, mcpSessions, sleep, startAi, startGroq, startMcp, stop } from "./harness.mjs";
+
+const { record, guard, finish } = createReporter();
+const MCP = 4001, MCP_SHORT = 4002, MCP_DEAD = 4003;
+let nextAi = 4011, nextGroq = 4021;
+
+const lastUser = (body) => [...body.messages].reverse().find((m) => m.role === "user")?.content ?? "";
+const lastRole = (body) => body.messages.at(-1)?.role;
+
+/** A scripted "model": decides by the newest user message; after tool results it just says Done. */
+function scripted({ body }) {
+  if (lastRole(body) === "tool") return { json: completion("Done.") };
+  const raw = String(lastUser(body));
+  const u = raw.includes("User request: ") ? raw.split("User request: ").pop() : raw; // ignore the map-context preamble
+  if (u.includes("boom")) return { status: 400, json: { error: { message: "bad request", type: "x" } } };
+  if (u.includes("slow")) return { delayMs: 900, json: completion("Slow done.") };
+  if (u.includes("hang")) return { hang: true };
+  if (u.includes("start over")) return { json: completion(null, [["clearScene", {}], ["createMarker", { location: "Pune" }]]) };
+  if (u.includes("remove Delhi")) return { json: completion(null, [["removeObject", { name: "Delhi" }]]) };
+  if (u.includes("add Mumbai")) return { json: completion(null, [["createMarker", { location: "Mumbai" }]]) };
+  if (u.includes("show Delhi")) return { json: completion(null, [["createMarker", { location: "Delhi" }]]) };
+  return { json: completion("Nothing to draw.") };
+}
+
+async function scenario(handler, env, fn, { mcp = MCP } = {}) {
+  const groq = await startGroq(nextGroq++, handler);
+  let ai;
+  try {
+    ai = await startAi(nextAi++, mcp, groq.port, env);
+    await fn({ groq, ai, say: (body, opts) => chat(ai.port, body, opts), stream: (body, opts) => chatStream(ai.port, body, opts) });
+  } finally { if (ai) await stop(ai.child); groq.close(); }
+}
+const names = (scene, t) => byType(scene, t).map((o) => o.name);
+
+async function main() {
+  const mcp = await startMcp(MCP);
+  const mcpShort = await startMcp(MCP_SHORT, { SESSION_TTL_MS: "700", SESSION_SWEEP_MS: "100" });
+  {
+    /* --------------------------- persistence across prompts --------------------------- */
+    await guard("C", () => scenario(scripted, {}, async ({ say, groq, ai }) => {
+      const base = await mcpSessions(MCP);
+      let r = await say({ prompt: "show Delhi", conversationId: "map-aaaaaaaa" });
+      record("C1 first prompt of a conversation: echoes the id, marks it new, draws Delhi",
+        r.status === 200 && r.json?.conversationId === "map-aaaaaaaa" && r.json?.isNewConversation === true && byType(r.json?.scene, "marker").length === 1,
+        `status=${r.status} ${JSON.stringify(r.json && { id: r.json.conversationId, isNew: r.json.isNewConversation })}`);
+      await sleep(200);
+      record("C1b the MCP session is KEPT open between prompts", (await mcpSessions(MCP)) === base + 1, `sessions=${await mcpSessions(MCP)} base=${base}`);
+      const firstUser = groq.requests[0].body.messages.filter((m) => m.role === "user");
+      record("C1c the very first prompt reaches the model unchanged (no map context, no history)", firstUser.length === 1 && firstUser[0].content === "show Delhi", JSON.stringify(firstUser));
+
+      const before = groq.requests.length;
+      r = await say({ prompt: "add Mumbai", conversationId: "map-aaaaaaaa" });
+      record("C2 follow-up ADDS to the same map (Delhi + Mumbai kept)",
+        r.status === 200 && r.json?.isNewConversation === false && names(r.json?.scene, "marker").sort().join() === "Delhi,Mumbai", `markers=${names(r.json?.scene, "marker")} isNew=${r.json?.isNewConversation}`);
+      record("C2b still exactly one MCP session for this conversation", (await mcpSessions(MCP)) === base + 1);
+      const msgs = groq.requests[before].body.messages;
+      const roles = msgs.map((m) => m.role).join();
+      record("C2c the model gets the earlier turn (prompt + its answer) before the new prompt", roles.startsWith("system,user,assistant,user") && msgs[1].content === "show Delhi", roles);
+      const lu = String(msgs.at(-1).content);
+      record("C2d the new prompt carries a description of what is already on the map", /Markers: "Delhi"/.test(lu) && /User request: add Mumbai/.test(lu), lu.slice(0, 160));
+
+      r = await say({ prompt: "show Delhi", conversationId: "map-bbbbbbbb" });
+      record("C3 another conversation id is a separate map (Delhi only, not Mumbai) and a second session",
+        r.json?.isNewConversation === true && names(r.json?.scene, "marker").join() === "Delhi" && (await mcpSessions(MCP)) === base + 2, `markers=${names(r.json?.scene, "marker")}`);
+
+      r = await say({ prompt: "remove Delhi", conversationId: "map-aaaaaaaa" });
+      record("C4 'remove Delhi' (model uses removeObject) leaves Mumbai only",
+        r.status === 200 && names(r.json?.scene, "marker").join() === "Mumbai" && names(r.json?.scene, "label").join() === "Mumbai", `markers=${names(r.json?.scene, "marker")} labels=${names(r.json?.scene, "label")}`);
+
+      r = await say({ prompt: "start over", conversationId: "map-aaaaaaaa" });
+      record("C5 'start over' (clearScene then Pune) leaves only Pune", names(r.json?.scene, "marker").join() === "Pune" && r.json?.scene.objects.length === 2, `markers=${names(r.json?.scene, "marker")}`);
+      for (const id of ["map-aaaaaaaa", "map-bbbbbbbb"]) await fetch(`http://127.0.0.1:${ai.port}/api/conversations/${id}`, { method: "DELETE" });
+    }));
+  }
+
+  await guard("D", () => scenario(scripted, {}, async ({ say, ai }) => {
+    const base = await mcpSessions(MCP);
+    await say({ prompt: "show Delhi", conversationId: "map-delete-1" });
+    const del = await fetch(`http://127.0.0.1:${ai.port}/api/conversations/map-delete-1`, { method: "DELETE" });
+    await sleep(200);
+    record("C6 DELETE /api/conversations/:id -> 204 and the MCP session is ended", del.status === 204 && (await mcpSessions(MCP)) === base, `status=${del.status} sessions=${await mcpSessions(MCP)} base=${base}`);
+    const r = await say({ prompt: "add Mumbai", conversationId: "map-delete-1" });
+    record("C6b after 'new map' the same id starts empty (Delhi is gone)", r.json?.isNewConversation === true && names(r.json?.scene, "marker").join() === "Mumbai", `markers=${names(r.json?.scene, "marker")}`);
+    const again = await fetch(`http://127.0.0.1:${ai.port}/api/conversations/never-existed`, { method: "DELETE" });
+    record("C6c DELETE of an unknown id is harmless (idempotent 204)", again.status === 204);
+    await fetch(`http://127.0.0.1:${ai.port}/api/conversations/map-delete-1`, { method: "DELETE" });
+  }));
+
+  await guard("E", () => scenario(scripted, {}, async ({ say, ai }) => {
+    const base = await mcpSessions(MCP);
+    const r = await say({ prompt: "show Delhi" });
+    await sleep(200);
+    record("C7 without conversationId nothing changes: no extra fields, session closed afterwards (old behaviour)",
+      r.status === 200 && r.json?.conversationId === undefined && r.json?.isNewConversation === undefined && Object.keys(r.json).sort().join() === "message,scene" && (await mcpSessions(MCP)) === base,
+      `keys=${Object.keys(r.json ?? {})} sessions=${await mcpSessions(MCP)} base=${base}`);
+
+    let bad = await say({ prompt: "show Delhi", conversationId: "bad id!" });
+    record("C9 an invalid conversationId is a 400 with a message", bad.status === 400 && /conversationId/.test(bad.json?.error ?? ""), `${bad.status} ${bad.text.slice(0, 100)}`);
+    bad = await say({ prompt: "show Delhi", conversationId: 12345678 });
+    record("C9b a non-string conversationId is a 400", bad.status === 400 && /string/.test(bad.json?.error ?? ""), `${bad.status} ${bad.text.slice(0, 100)}`);
+    await sleep(200);
+    record("C9c rejected requests leave no session behind", (await mcpSessions(MCP)) === base);
+  }));
+
+  await guard("F", () => scenario(scripted, {}, async ({ say, ai }) => {
+    const slow = say({ prompt: "slow one", conversationId: "map-busy-0001" });
+    await sleep(250);
+    const second = await say({ prompt: "show Delhi", conversationId: "map-busy-0001" });
+    const first = await slow;
+    record("C8 a second request on a busy conversation gets 409 with a clear message; the first still finishes",
+      second.status === 409 && /still running/.test(second.json?.error ?? "") && first.status === 200, `first=${first.status} second=${second.status} ${second.text.slice(0, 80)}`);
+    await fetch(`http://127.0.0.1:${ai.port}/api/conversations/map-busy-0001`, { method: "DELETE" });
+  }));
+
+  await guard("G", () => scenario(scripted, { MAX_CONVERSATIONS: "2" }, async ({ say, ai }) => {
+    const base = await mcpSessions(MCP);
+    await say({ prompt: "show Delhi", conversationId: "cap-aaaaaaaa" });
+    await sleep(30);
+    await say({ prompt: "show Delhi", conversationId: "cap-bbbbbbbb" });
+    await sleep(30);
+    await say({ prompt: "show Delhi", conversationId: "cap-cccccccc" });
+    await sleep(300);
+    record("C12 at MAX_CONVERSATIONS the oldest idle map is closed (2 sessions, not 3)", (await mcpSessions(MCP)) === base + 2, `sessions=${await mcpSessions(MCP)} base=${base}`);
+    const r = await say({ prompt: "show Delhi", conversationId: "cap-aaaaaaaa" });
+    record("C12b the evicted conversation starts fresh next time", r.status === 200 && r.json?.isNewConversation === true);
+    await sleep(100);
+    for (const id of ["cap-aaaaaaaa", "cap-bbbbbbbb", "cap-cccccccc"]) await fetch(`http://127.0.0.1:${ai.port}/api/conversations/${id}`, { method: "DELETE" });
+  }));
+
+  await guard("T", () => scenario(scripted, { CONVERSATION_TTL_MS: "500", CONVERSATION_SWEEP_MS: "100" }, async ({ say, ai }) => {
+    const base = await mcpSessions(MCP);
+    await say({ prompt: "show Delhi", conversationId: "ttl-aaaaaaaa" });
+    const during = (await (await fetch(`http://127.0.0.1:${ai.port}/health`)).json()).activeConversations;
+    await sleep(1300);
+    const after = (await (await fetch(`http://127.0.0.1:${ai.port}/health`)).json()).activeConversations;
+    record("C11 an idle conversation is closed after its TTL (ai-server and MCP session both gone)", during === 1 && after === 0 && (await mcpSessions(MCP)) === base, `during=${during} after=${after} sessions=${await mcpSessions(MCP)} base=${base}`);
+    const r = await say({ prompt: "add Mumbai", conversationId: "ttl-aaaaaaaa" });
+    record("C11b the id then simply starts a new map", r.json?.isNewConversation === true && names(r.json?.scene, "marker").join() === "Mumbai");
+    await fetch(`http://127.0.0.1:${ai.port}/api/conversations/ttl-aaaaaaaa`, { method: "DELETE" });
+  }));
+
+  await guard("L", () => scenario(scripted, {}, async ({ say, ai }) => {
+    await say({ prompt: "show Delhi", conversationId: "lost-bbbbbbbb" });
+    await sleep(1600); // MCP_SHORT forgets idle sessions after 700 ms
+    const r = await say({ prompt: "add Mumbai", conversationId: "lost-bbbbbbbb" });
+    record("C10 the MCP server forgot the session: request still succeeds as a NEW map (flagged isNewConversation)",
+      r.status === 200 && r.json?.isNewConversation === true && names(r.json?.scene, "marker").join() === "Mumbai", `status=${r.status} markers=${names(r.json?.scene, "marker")} ${r.text.slice(0, 120)}`);
+    record("C10b it was logged", /MCP session lost/.test(ai.getLog()));
+    await fetch(`http://127.0.0.1:${ai.port}/api/conversations/lost-bbbbbbbb`, { method: "DELETE" });
+  }, { mcp: MCP_SHORT }));
+
+  await guard("H", () => scenario(scripted, {}, async ({ say, groq, ai }) => {
+    await say({ prompt: "show Delhi", conversationId: "fail-aaaaaaaa" });
