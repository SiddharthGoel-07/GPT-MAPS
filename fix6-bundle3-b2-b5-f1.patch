+    const bad = await stream({ prompt: "   " });
+    record("S5 an error BEFORE anything was sent is a normal HTTP error (400 JSON), not a stream", bad.status === 400 && /Missing prompt/.test(bad.text), `${bad.status} ${bad.text.slice(0, 80)}`);
