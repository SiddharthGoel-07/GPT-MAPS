{
  "name": "map-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Map Renderer monorepo foundation",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "format": "npm run --workspaces --if-present format",
    "dev": "npm run --workspaces --if-present dev",
    "dev:server": "npm run dev --workspace @map-renderer/server",
    "dev:ai": "npm run dev --workspace @map-renderer/ai-server",
    "dev:web": "npm run dev --workspace @map-renderer/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.37.0"
  }
}